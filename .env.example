NODE_ENV=development
PORT=5000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hair_salon?schema=public"
# For hosted databases, use the provider's direct URL for Prisma CLI migrations.
# DIRECT_URL="postgresql://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require&connect_timeout=30"
REDIS_URL="redis://localhost:6379"
CORS_ORIGIN="http://localhost:3000"
JWT_ACCESS_SECRET="replace-with-a-long-random-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="replace-with-a-long-random-refresh-secret"
JWT_REFRESH_EXPIRES_IN="7d"

# Gmail: use an App Password for SMTP_PASSWORD.
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-google-app-password
EMAIL_SENDER="ABC Hair <your-email@gmail.com>"
