{
  "name": "hair-salon-backend",
  "version": "1.0.0",
  "main": "dist/src/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "test:database": "tsx --test src/app/utils/retry-database.test.ts",
    "test:errors": "tsx --test src/app/utils/normalize-error.test.ts cloudflare/upload-errors.test.mjs",
    "test:cloudflare": "node --test cloudflare/proof/financial-flow.test.mjs",
    "test:booking": "tsx --test cloudflare/booking-regression.test.mjs",
    "test:notifications": "tsx --test cloudflare/notification-regression.test.mjs",
    "test:auth": "tsx --test src/app/module/auth/auth.validation.test.ts src/app/utils/jwt.test.ts src/app/utils/auth-cookies.test.ts",
    "cloudflare:generate": "node scripts/prepare-cloudflare.mjs && prisma generate --config cloudflare/prisma.config.ts && node scripts/check-cloudflare-schema.mjs",
    "cloudflare:build": "npm run cloudflare:generate && node scripts/build-cloudflare.mjs",
    "cloudflare:dev": "npm run cloudflare:build && wrangler dev",
    "cloudflare:check": "npm run cloudflare:build && wrangler deploy --dry-run",
    "cloudflare:deploy": "npm run cloudflare:build && wrangler deploy",
    "cloudflare:deploy:staging": "npm run cloudflare:build && wrangler deploy --env staging",
    "test:cloudflare:database": "node scripts/test-cloudflare-runtime.mjs",
    "test:cloudflare:api": "node scripts/build-cloudflare.mjs --test && node --test cloudflare/runtime.integration.test.mjs",
    "test:regression": "prisma generate --config cloudflare/node-client.config.ts && npm run build && npm run test:errors && npm run test:auth && npm run test:smtp && npm run test:database && npm run test:booking && npm run test:notifications && npm run test:group-refunds && npm run test:cloudflare && npm run cloudflare:generate && npm run test:cloudflare:database && npm run test:cloudflare:migrations && npm run test:cloudflare:api && npm run test:book-now",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "test:smtp": "node --test cloudflare/smtp.test.mjs",
    "test:cloudflare:migrations": "node scripts/build-cloudflare.mjs && node scripts/test-cloudflare-migrations.mjs",
    "test:group-refunds": "tsx --test cloudflare/group-refund-safety.test.mjs",
    "test:book-now": "node scripts/build-cloudflare.mjs --test && node --test cloudflare/book-now.integration.test.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@prisma/adapter-d1": "7.10.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@types/crypto-js": "^4.2.2",
    "@types/ejs": "^3.1.5",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "crypto-js": "^4.2.0",
    "dotenv": "^18.0.0",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.3.0",
    "http-status": "^2.1.0",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.10",
    "openai": "^6.49.0",
    "path": "^0.12.7",
    "pg": "^8.16.3",
    "redis": "^6.2.1",
    "resend": "^6.32.1",
    "stripe": "^22.6.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20251014.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "esbuild": "0.28.2",
    "miniflare": "3.20250718.3",
    "prisma": "^7.10.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "wrangler": "4.45.0"
  }
}
