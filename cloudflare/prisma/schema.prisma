model GroupPurchase {
  emailPurchaseConfirmedAt DateTime?
  id                       String    @id @default(uuid())
  customerId               String
  packageId                String
  purchaseBranchId         String?
  purchaseBranch           Branch?   @relation("PurchasePolicyBranch", fields: [purchaseBranchId], references: [id], onDelete: Restrict)

  quantity  Int
  unitPrice BigInt
  amount    BigInt

  paymentStatus PaymentStatus @default(PENDING)

  reservationExpiresAt DateTime?
  purchasedAt          DateTime?
  settledPaymentId     String?   @unique
  settledPayment       Payment?  @relation("GroupPurchaseSettlement", fields: [settledPaymentId], references: [id], onDelete: Restrict)

  bookingMethod        BookingMethod?
  depositPercentage    BigInt?
  depositAmount        BigInt?
  remainingAmount      BigInt?
  purchaseFlow         GroupPurchaseFlow @default(BUY_NOW_BOOK_LATER)
  customer             User              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  package              Package           @relation(fields: [packageId], references: [id], onDelete: Restrict)
  payments             Payment[]
  appointments         Appointment[]
  forfeitedQuantity    Int               @default(0)
  refundedQuantity     Int               @default(0)
  // Package refund policy captured at purchase time
  refundPolicySnapshot Json?
  refundPolicyVersion  Int?

  // Redemption cancellation policy captured at purchase time
  cancellationPolicySnapshot Json?
  cancellationPolicyVersion  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([packageId])
  @@index([paymentStatus])
  @@index([reservationExpiresAt])
}

model Notification {
  id           String  @id @default(uuid())
  userId       String
  type         String
  title        String
  message      String
  isRead       Boolean @default(false)
  translations Json?
  // Internal reschedule snapshot; excluded from notification API responses.
  emailIntent  Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model Package {
  id           String      @id @default(uuid())
  type         PackageType
  name         String
  description  String?
  translations Json?

  // =====================================================
  // PACKAGE DISPLAY INFORMATION
  // =====================================================

  validDays      Int?
  applicableFor  Json @default("[]")
  purchaseNotice Json @default("[]")
  howToUse       Json @default("[]")

  // =====================================================
  // PRICING
  // =====================================================

  regularPrice    BigInt
  packagePrice    BigInt
  durationMinutes Int

  status        PackageStatus @default(ACTIVE)
  listingStatus ListingStatus @default(LISTED)

  // =====================================================
  // GROUP PURCHASE SETTINGS
  // =====================================================

  capacity                 Int?
  soldQuantity             Int       @default(0)
  reservedQuantity         Int       @default(0)
  purchaseLimitPerCustomer Int?
  salesStartAt             DateTime?
  salesEndAt               DateTime?

  // =====================================================
  // RELATIONS
  // =====================================================

  groupPurchases GroupPurchase[]
  staff          StaffPackage[]
  appointments   Appointment[]
  promotions     PromotionPackage[]

  services PackageService[]
  branches PackageBranch[]
  images   PackageImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PackageService {
  packageId String
  serviceId String

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@id([packageId, serviceId])
  @@index([serviceId])
}

model PackageBranch {
  packageId String
  branchId  String

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([packageId, branchId])
  @@index([branchId])
}

model PackageImage {
  id        String @id @default(uuid())
  packageId String
  objectKey String

  isPrimary Boolean @default(false)
  sortOrder Int     @default(0)

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([packageId])
}

model Payment {
  id String @id @default(uuid())

  customerId      String
  appointmentId   String?
  groupPurchaseId String?
  orderNumber     String? @unique

  purpose  PaymentPurpose
  provider PaymentProvider @default(STRIPE)

  salonPaymentMethod SalonPaymentMethod?

  amount   BigInt
  currency String  @default("HKD")

  status PaymentStatus @default(PENDING)

  providerPaymentId String? @unique

  paidAt     DateTime?
  failedAt   DateTime?
  refundedAt DateTime?

  customer User @relation(fields: [customerId], references: [id], onDelete: Restrict)

  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Restrict)

  groupPurchase        GroupPurchase? @relation(fields: [groupPurchaseId], references: [id], onDelete: Restrict)
  settledGroupPurchase GroupPurchase? @relation("GroupPurchaseSettlement")

  refunds Refund[]
  refundAllocations RefundAllocation[]
  walletTransactions WalletTransaction[]

  walletTopupId String?
  walletTopup   WalletTopup? @relation(fields: [walletTopupId], references: [id], onDelete: Restrict)

  refundRequests RefundRequest[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([walletTopupId])
  @@index([customerId])
  @@index([appointmentId])
  @@index([groupPurchaseId])
  @@index([status])
}

model StripeWebhookEvent {
  id String @id

  type String

  processedAt DateTime @default(now())
}

model Refund {
  id String @id @default(uuid())

  paymentId String

  providerRefundId String? @unique

  amount BigInt

  reason String

  status RefundStatus @default(PENDING)

  refundedAt           DateTime?
  idempotencyKey       String?   @unique
  refundClaimToken     String?   @unique
  refundClaimExpiresAt DateTime?
  refundAttemptedAt    DateTime?

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refundRequest RefundRequest?
  refundAllocation RefundAllocation?

  @@index([paymentId])
  @@index([status])
}

model Promotion {
  id String @id @default(uuid())

  name String

  minimumTopup BigInt
  bonusAmount  BigInt

  startAt DateTime
  endAt   DateTime

  status PromotionStatus @default(ACTIVE)

  imageObjectKey String?

  branches     PromotionBranch[]
  services     PromotionService[]
  packages     PromotionPackage[]
  walletTopups WalletTopup[]
  translations Json?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([status])
  @@index([startAt])
  @@index([endAt])
}

model PromotionBranch {
  promotionId String
  branchId    String

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([promotionId, branchId])
  @@index([branchId])
}

model PromotionService {
  promotionId String
  serviceId   String

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([promotionId, serviceId])
  @@index([serviceId])
}

model PromotionPackage {
  promotionId String
  packageId   String

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@id([promotionId, packageId])
  @@index([packageId])
}

enum RefundRequestStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSING
  COMPLETED
  FAILED
}

model RefundRequest {
  id String @id @default(uuid())

  customerId String
  paymentId  String

  amount BigInt
  reason String

  status RefundRequestStatus @default(PENDING)

  reviewedBy String?
  reviewedAt DateTime?
  reviewNote String?

  refundId String? @unique

  customer User  @relation("CustomerRefundRequests", fields: [customerId], references: [id], onDelete: Restrict)
  reviewer User? @relation("ReviewedRefundRequests", fields: [reviewedBy], references: [id], onDelete: SetNull)

  payment     Payment           @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  refund      Refund?           @relation(fields: [refundId], references: [id], onDelete: SetNull)
  allocations RefundAllocation[]
  // Type of refund/cancellation request
  requestType RefundRequestType @default(APPOINTMENT_CANCELLATION)

  // Original policy used to calculate eligibility
  policySnapshot Json?
  policyVersion  Int?

  // Refund calculation details
  eligiblePaidAmount BigInt?
  refundPercentage   BigInt?
  refundDeduction    BigInt?

  // Cancellation-only request (0% refund)
  isCancellationOnly Boolean @default(false)

  // Policy evaluation timestamp
  policyEvaluatedAt DateTime?

  // Idempotency for duplicate request prevention
  idempotencyKey String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([paymentId])
  @@index([status])
}

model RefundAllocation {
  id String @id @default(uuid())
  refundRequestId String
  paymentId String
  refundId String? @unique
  amount BigInt
  provider PaymentProvider
  status String @default("RESERVED")
  idempotencyKey String @unique
  submittedAt DateTime?
  lastErrorCode String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  request RefundRequest @relation(fields: [refundRequestId], references: [id], onDelete: Restrict)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  refund Refund? @relation(fields: [refundId], references: [id], onDelete: Restrict)
  @@unique([refundRequestId, paymentId])
  @@index([paymentId, status])
  @@index([status])
}

model Review {
  id String @id @default(uuid())

  customerId    String
  appointmentId String @unique
  branchId      String
  staffId       String

  rating  Int
  comment String?

  moderationStatus ReviewModerationStatus @default(PENDING)
  moderationReason String?

  replyText   String?
  repliedAt   DateTime?
  repliedById String?

  customer  User  @relation("CustomerReviews", fields: [customerId], references: [id], onDelete: Cascade)
  repliedBy User? @relation("ReviewRepliedBy", fields: [repliedById], references: [id], onDelete: SetNull)

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  images ReviewImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([branchId])
  @@index([staffId])
  @@index([rating])
  @@index([moderationStatus])
  @@index([repliedById])
}

model ReviewImage {
  id String @id @default(uuid())

  reviewId  String
  objectKey String

  sortOrder Int @default(0)

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([reviewId])
}

generator client {
  provider = "prisma-client"
  output = "../../generated/sqlite"
  runtime = "cloudflare"
}

datasource db {
  provider = "sqlite"
}

model Service {
  id              String        @id @default(uuid())
  name            String
  description     String?
  price           BigInt
  durationMinutes Int
  status          ServiceStatus @default(ACTIVE)

  // Service display information
  isPopular           Boolean              @default(false)
  processSteps        Json             @default("[]")
  bookingNotes        Json             @default("[]")
  staffPortfolioCases StaffPortfolioCase[]
  images              ServiceImage[]
  branches            ServiceBranch[]
  packages            PackageService[]
  staff               StaffService[]
  appointments        Appointment[]
  promotions          PromotionService[]

  // Multilingual support
  translations Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ServiceImage {
  id        String @id @default(uuid())
  serviceId String
  objectKey String

  isPrimary Boolean @default(false)
  sortOrder Int     @default(0)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serviceId])
}

model ServiceBranch {
  serviceId String
  branchId  String

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([serviceId, branchId])
  @@index([branchId])
}

model Staff {
  id     String @id @default(uuid())
  userId String @unique

  name            String
  email           String  @unique
  phone           String?
  roleTitle       String
  specialization  String?
  description     String?
  avatarObjectKey String?
  translations    Json?

  status StaffStatus @default(ACTIVE)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  branches            StaffBranch[]
  services            StaffService[]
  packages            StaffPackage[]
  schedule            StaffSchedule[]
  unavailability      StaffUnavailability[]
  appointments        Appointment[]
  reviews             Review[]
  staffPortfolioCases StaffPortfolioCase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StaffBranch {
  staffId  String
  branchId String

  staff  Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([staffId, branchId])
  @@index([branchId])
}

model StaffService {
  staffId   String
  serviceId String

  staff   Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([staffId, serviceId])
  @@index([serviceId])
}

model StaffPackage {
  staffId   String
  packageId String

  staff   Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([staffId, packageId])
  @@index([packageId])
}

model StaffSchedule {
  id        String    @id @default(uuid())
  staffId   String
  branchId  String
  day       DayOfWeek
  startTime String
  endTime   String

  staff  Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([staffId, branchId, day])
  @@index([staffId])
  @@index([branchId])
}

model StaffUnavailability {
  id        String                  @id @default(uuid())
  staffId   String
  type      StaffUnavailabilityType
  date      DateTime
  startTime String
  endTime   String
  reason    String?

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([staffId])
  @@index([date])
  @@index([staffId, date])
}

model StaffPortfolioCase {
  id        String  @id @default(uuid())
  staffId   String
  serviceId String?

  title       String
  description String?
  tags        Json @default("[]")

  translations Json?

  status    StaffPortfolioStatus @default(DRAFT)
  sortOrder Int                  @default(0)
  staff     Staff                @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service   Service?             @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  images StaffPortfolioCaseImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([staffId])
  @@index([serviceId])
  @@index([staffId, status])
  @@index([staffId, sortOrder])
}

model StaffPortfolioCaseImage {
  id        String @id @default(uuid())
  caseId    String
  objectKey String

  isCover   Boolean @default(false)
  sortOrder Int     @default(0)

  portfolioCase StaffPortfolioCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([caseId])
  @@index([caseId, sortOrder])
}

model User {
  id                     String                @id @default(uuid())
  name                   String
  email                  String                @unique
  phone                  String?               @unique
  passwordHash           String
  preferredLanguage      String                @default("en")
  role                   Role                  @default(CUSTOMER)
  status                 UserStatus            @default(ACTIVE)
  emailVerified          Boolean               @default(false)
  emailVerifiedAt        DateTime?
  groupPurchases         GroupPurchase[]
  mustChangePassword     Boolean               @default(false)
  avatarObjectKey        String?
  staffProfile           Staff?
  managedBranches        BranchManagerBranch[]
  appointments           Appointment[]         @relation("CustomerAppointments")
  verifiedAppointments   Appointment[]         @relation("AppointmentQrVerifier")
  payments               Payment[]
  wallet                 Wallet?
  reviews                Review[]              @relation("CustomerReviews")
  reviewReplies          Review[]              @relation("ReviewRepliedBy")
  notifications          Notification[]
  auditLogs              AuditLog[]
  refundRequests         RefundRequest[]       @relation("CustomerRefundRequests")
  reviewedRefundRequests RefundRequest[]       @relation("ReviewedRefundRequests")
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
}

model Wallet {
  id String @id @default(uuid())

  customerId String @unique

  paidBalance  BigInt @default(0)
  bonusBalance BigInt @default(0)

  currency String @default("HKD")

  customer User @relation(fields: [customerId], references: [id], onDelete: Restrict)

  transactions WalletTransaction[]
  topups       WalletTopup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
}

model WalletTransaction {
  id String @id @default(uuid())

  walletId String

  type WalletTransactionType

  balanceType BalanceType

  amount BigInt

  referenceId String?
  paymentId String?
  ledgerKey String? @unique
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([walletId])
  @@index([paymentId])
  @@index([type])
  @@index([createdAt])
}

model WalletTopup {
  id String @id @default(uuid())

  walletId    String
  promotionId String?

  amount         BigInt
  potentialBonus BigInt @default(0)

  status WalletTopupStatus @default(PENDING)

  providerPaymentId String? @unique

  paidAt   DateTime?
  failedAt DateTime?

  wallet    Wallet     @relation(fields: [walletId], references: [id], onDelete: Restrict)
  promotion Promotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)

  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([walletId])
  @@index([promotionId])
  @@index([status])
}
