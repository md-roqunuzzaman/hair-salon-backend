model BranchCancellationPolicy {
  id String @id @default(uuid())

  branchId String @unique
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  isEnabled Boolean @default(true)

  cancellationAllowed Boolean @default(true)
  refundAllowed       Boolean @default(true)
  policyFormat        String  @default("REFUND_TIERS_V1")

  minimumCancellationMinutes Int @default(120)

  refundTiers Json

  nonRefundable Boolean @default(false)

  version Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GroupPurchaseRefundPolicy {
  id String @id @default(uuid())

  branchId String @unique
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  isEnabled Boolean @default(true)

  refundAllowed Boolean @default(true)
  policyFormat  String  @default("REFUND_TIERS_V1")
  boundaryMode  String  @default("MINIMUM_INCLUSIVE")

  // Refund rules based on minutes since purchase
  refundTiers Json

  // Package usage restrictions
  allowPartiallyUsedRefund Boolean @default(false)
  allowExpiredRefund       Boolean @default(false)

  // Whether existing appointments must be cancelled first
  requireNoActiveAppointments Boolean @default(true)

  version Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GroupPurchaseCancellationPolicy {
  id String @id @default(uuid())

  branchId String @unique
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  // =====================================================
  // POLICY SETTINGS
  // =====================================================

  isEnabled Boolean @default(true)

  cancellationAllowed Boolean @default(true)

  // Minimum minutes before appointment start
  // Cancellation is blocked below this threshold
  minimumCancellationMinutes Int @default(120)

  // Cancellation at or above this threshold
  // restores the package entitlement
  restorationMinimumMinutes Int @default(1440)

  // Cancellation allowed below restorationMinimumMinutes
  // but at or above minimumCancellationMinutes
  lateCancellationOutcome EntitlementCancellationOutcome @default(FORFEITED)

  // =====================================================
  // VERSIONING
  // =====================================================

  version Int @default(1)

  // =====================================================
  // TIMESTAMPS
  // =====================================================

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Appointment {
  id          String @id @default(uuid())
  orderNumber String @unique
  customerId  String
  branchId    String
  staffId     String

  serviceId       String?
  packageId       String?
  groupPurchaseId String?

  bookingMethod     BookingMethod
  appointmentStatus AppointmentStatus
  paymentStatus     PaymentStatus

  date                    DateTime
  startTime               String
  endTime                 String
  emailScheduleRevision   Int       @default(0)
  emailPaymentConfirmedAt DateTime?

  price           BigInt
  currency        String  @default("HKD")
  durationMinutes Int

  itemName             String
  itemNameTranslations Json?

  holdExpiresAt DateTime?

  qrToken                    String?   @unique
  qrVerifiedAt               DateTime?
  qrVerifiedBy               String?
  // Cancellation policy captured when appointment is booked
  cancellationPolicySnapshot Json?
  cancellationPolicyVersion  Int?
  cancellationIdempotencyKey String?   @unique
  cancellationResult         Json?

  // Group purchase entitlement cancellation outcome
  entitlementCancellationOutcome EntitlementCancellationOutcome?
  completedAt                    DateTime?
  completionNotes                String?
  cancelledAt                    DateTime?
  cancellationReason             String?
  noShowAt                       DateTime?
  noShowReason                   String?

  customer User @relation("CustomerAppointments", fields: [customerId], references: [id], onDelete: Restrict)

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Restrict)

  service Service? @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  package Package? @relation(fields: [packageId], references: [id], onDelete: Restrict)

  // Group Purchase Appointment Booking
  groupPurchase GroupPurchase? @relation(fields: [groupPurchaseId], references: [id], onDelete: Restrict)

  verifiedByUser User? @relation("AppointmentQrVerifier", fields: [qrVerifiedBy], references: [id], onDelete: SetNull)

  depositPercentage BigInt?
  depositAmount     BigInt?
  remainingAmount   BigInt?

  payments Payment[]
  review   Review?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([branchId])
  @@index([staffId])
  @@index([serviceId])
  @@index([packageId])
  @@index([groupPurchaseId])
  @@index([date])
  @@index([staffId, date])
  @@index([appointmentStatus])
  @@index([paymentStatus])
  @@index([holdExpiresAt])
}

model AuditLog {
  id String @id @default(uuid())

  userId String?

  action String

  entityType String

  entityId String?

  metadata Json?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
}

model Banner {
  id          String       @id @default(uuid())
  brandId     String
  title       String
  description String?
  status      BannerStatus @default(DRAFT)
  scope       BannerScope  @default(SELECTED_BRANCHES)

  startAt DateTime?
  endAt   DateTime?

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  brand    Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  branches BannerBranch[]
  media    BannerMedia[]

  // Indexes
  @@index([brandId, status])
  @@index([brandId, scope])
  @@index([startAt, endAt])
  @@index([sortOrder])
}

model BannerBranch {
  bannerId String
  branchId String

  // Relations
  banner Banner @relation(fields: [bannerId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([bannerId, branchId])
  @@index([branchId])
}

model BannerMedia {
  id        String          @id @default(uuid())
  bannerId  String
  mediaType BannerMediaType

  // Cloudflare R2 object key
  objectKey String

  // Display order within the banner
  sortOrder Int @default(0)

  createdAt DateTime @default(now())

  // Relations
  banner Banner @relation(fields: [bannerId], references: [id], onDelete: Cascade)

  @@index([bannerId, sortOrder])
}

model BannerCarouselSetting {
  id String @id @default(uuid())

  branchId String @unique

  imageIntervalMs Int @default(5000)
  videoIntervalMs Int @default(15000)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  brand   Brand?  @relation(fields: [brandId], references: [id])
  brandId String?
}

model Branch {
  id             String  @id @default(uuid())
  name           String
  address        String
  phone          String?
  description    String?
  imageObjectKey String?
  translations   Json?
  latitude       Float?
  longitude      Float?

  bannerCarouselSettings          BannerCarouselSetting[]
  status                          BranchStatus                     @default(ACTIVE)
  bookingPolicy                   BranchBookingPolicy?
  businessHours                   BranchBusinessHour[]
  hourlyCapacities                BranchHourlyCapacity[]
  services                        ServiceBranch[]
  packages                        PackageBranch[]
  staff                           StaffBranch[]
  managers                        BranchManagerBranch[]
  staffSchedules                  StaffSchedule[]
  appointments                    Appointment[]
  promotions                      PromotionBranch[]
  reviews                         Review[]
  bannerAssignments               BannerBranch[]
  cancellationPolicy              BranchCancellationPolicy?
  groupPurchaseRefundPolicy       GroupPurchaseRefundPolicy?
  groupPurchaseCancellationPolicy GroupPurchaseCancellationPolicy?

  policyPurchases GroupPurchase[] @relation("PurchasePolicyBranch")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model BranchBusinessHour {
  id       String    @id @default(uuid())
  branchId String
  day      DayOfWeek

  isClosed  Boolean @default(false)
  openTime  String?
  closeTime String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, day])
}

model BranchBookingPolicy {
  id       String @id @default(uuid())
  branchId String @unique

  slotIntervalMinutes         Int                @default(5)
  minimumBookingNoticeMinutes Int                @default(120)
  maximumAdvanceBookingDays   Int                @default(30)
  cancellationCutoffMinutes     Int                @default(720)
  rescheduleCutoffMinutes       Int                @default(720)
  reserveExpiryRule           ReserveExpiryRule  @default(APPOINTMENT_TIME)
  depositEnabled              Boolean            @default(true)
  depositPercentage           BigInt?
  // Merchant-configurable booking methods
  allowedBookingMethods       Json    @default("[\"PAY_NOW\",\"DEPOSIT\",\"RESERVE_NOW\"]")
  qrVerificationRule          QrVerificationRule @default(BEFORE_START_TIME)
  createdAt                   DateTime           @default(now())
  updatedAt                   DateTime           @updatedAt

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
}

model BranchManagerBranch {
  userId   String
  branchId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, branchId])
  @@index([branchId])
}

model BranchHourlyCapacity {
  id String @id @default(uuid())

  branchId String
  day      DayOfWeek

  maxBookingsPerHour Int

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, day])
  @@index([branchId])
}

model Brand {
  id            String   @id @default(uuid())
  name          String
  description   String?
  phone         String?
  email         String?
  logoObjectKey String?
  translations  Json?
  banners       Banner[]
  // Banner carousel override settings

  primaryColor           String                  @default("#0F766E")
  secondaryColor         String                  @default("#B45309")
  backgroundColor        String                  @default("#F3F1EA")
  surfaceColor           String                  @default("#FBFAF6")
  textColor              String                  @default("#1A1813")
  mutedTextColor         String                  @default("#8B8676")
  lineColor              String                  @default("#E2DED3")
  onPrimaryColor         String                  @default("#FFFFFF")
  emailSetting           BrandEmailSetting?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  bannerCarouselSettings BannerCarouselSetting[]
}

model BrandEmailSetting {
  id       String        @id @default(uuid())
  brandId  String        @unique
  provider EmailProvider

  // Sender information
  fromName  String
  fromEmail String

  // SMTP configuration
  smtpHost     String?
  smtpPort     Int?
  smtpSecure   Boolean?
  smtpUsername String?

  // Encrypted SMTP password / authorization code
  encryptedCredential String?

  // Microsoft 365 OAuth credentials/tokens
  oauthDataEncrypted String?

  // Configuration status
  isEnabled            Boolean   @default(true)
  isVerified           Boolean   @default(false)
  configurationVersion Int       @default(1)
  providerData         Json?
  lastTestAt           DateTime?
  lastErrorCode        String?

  // Relations
  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmailOutbox {
  id String @id @default(uuid())

  brandId       String
  userId        String?
  appointmentId String?

  eventType      String
  idempotencyKey String @unique

  recipientEmail String
  subject        String
  html           String

  status      String @default("PENDING")
  attempts    Int    @default(0)
  maxAttempts Int    @default(3)

  nextAttemptAt  DateTime             @default(now())
  lockedUntil    DateTime?
  claimToken     String?
  attemptedAt    DateTime?
  text           String?
  validationData Json?
  skipReason     String?
  terminalAt     DateTime?
  history        EmailOutboxHistory[]

  sentAt            DateTime?
  lastError         String?
  provider          String?
  providerMessageId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, nextAttemptAt])
  @@index([brandId, createdAt])
  @@index([appointmentId])
}

model EmailOutboxHistory {
  id        String      @id @default(uuid())
  outboxId  String
  outbox    EmailOutbox @relation(fields: [outboxId], references: [id], onDelete: Restrict)
  status    String
  sequence  Int
  attempt   Int
  code      String?
  provider  String?
  actorId   String?
  createdAt DateTime    @default(now())

  @@unique([outboxId, sequence])
  @@index([outboxId, createdAt, id])
}

// Committed business records are reconciled independently of their transactions.
// Each bounded scan cycles from a fixed restoration cutoff to catch late commits.
model EmailEventCursor {
  id        String    @id
  startedAt DateTime  @default(now())
  afterAt   DateTime?
  afterId   String?
}

