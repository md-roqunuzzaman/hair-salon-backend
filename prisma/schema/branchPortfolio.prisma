model BranchPortfolioCase {
  id        String  @id @default(uuid())
  branchId  String
  serviceId String?
  staffId   String?

  title       String
  description String?
  tags        Json    @default("[]")

  translations Json?

  status    StaffPortfolioStatus @default(DRAFT)
  sortOrder Int                  @default(0)

  // Relations
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  staff Staff? @relation(fields: [staffId], references: [id], onDelete: SetNull)

  images BranchPortfolioCaseImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
  @@index([serviceId])
  @@index([staffId])
  @@index([branchId, status])
  @@index([branchId, sortOrder])
}

model BranchPortfolioCaseImage {
  id        String @id @default(uuid())
  caseId    String
  objectKey String

  isCover   Boolean @default(false)
  sortOrder Int     @default(0)

  portfolioCase BranchPortfolioCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([caseId])
  @@index([caseId, sortOrder])
}
