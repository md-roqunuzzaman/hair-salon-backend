model Banner {
  id          String       @id @default(uuid())
  brandId     String
  title       String
  description String?
  status      BannerStatus @default(DRAFT)
  scope       BannerScope  @default(SELECTED_BRANCHES)

  startAt DateTime?
  endAt   DateTime?

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  brand    Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  branches BannerBranch[]
  media    BannerMedia[]

  // Indexes
  @@index([brandId, status])
  @@index([brandId, scope])
  @@index([startAt, endAt])
  @@index([sortOrder])
}

model BannerBranch {
  bannerId String
  branchId String

  // Relations
  banner Banner @relation(fields: [bannerId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([bannerId, branchId])
  @@index([branchId])
}

model BannerMedia {
  id        String          @id @default(uuid())
  bannerId  String
  mediaType BannerMediaType

  // Cloudflare R2 object key
  objectKey String

  // Display order within the banner
  sortOrder Int @default(0)

  createdAt DateTime @default(now())

  // Relations
  banner Banner @relation(fields: [bannerId], references: [id], onDelete: Cascade)

  @@index([bannerId, sortOrder])
}
