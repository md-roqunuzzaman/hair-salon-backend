model StaffPortfolioCase {
  id        String  @id @default(uuid())
  staffId   String
  branchId  String?
  serviceId String?

  title       String
  description String?
  tags        String[] @default([])

  translations Json?

  status                StaffPortfolioStatus @default(DRAFT)
  sortOrder             Int                  @default(0)
  showInBranchPortfolio Boolean              @default(true)

  staff   Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  branch  Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  images StaffPortfolioCaseImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([staffId])
  @@index([branchId])
  @@index([serviceId])
  @@index([staffId, status])
  @@index([staffId, sortOrder])
  @@index([branchId, status, showInBranchPortfolio])
}

model StaffPortfolioCaseImage {
  id        String @id @default(uuid())
  caseId    String
  objectKey String

  isCover   Boolean @default(false)
  sortOrder Int     @default(0)

  portfolioCase StaffPortfolioCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([caseId])
  @@index([caseId, sortOrder])
}
