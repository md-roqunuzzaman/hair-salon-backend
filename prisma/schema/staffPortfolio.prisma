model StaffPortfolioCase {
  id        String  @id @default(uuid())
  staffId   String
  serviceId String?

  title       String
  description String?
  tags        String[] @default([])

  translations Json?

  status    StaffPortfolioStatus @default(DRAFT)
  sortOrder Int                  @default(0)
  staff     Staff                @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service   Service?             @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  images StaffPortfolioCaseImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([staffId])
  @@index([serviceId])
  @@index([staffId, status])
  @@index([staffId, sortOrder])
}

model StaffPortfolioCaseImage {
  id        String @id @default(uuid())
  caseId    String
  objectKey String

  isCover   Boolean @default(false)
  sortOrder Int     @default(0)

  portfolioCase StaffPortfolioCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([caseId])
  @@index([caseId, sortOrder])
}
