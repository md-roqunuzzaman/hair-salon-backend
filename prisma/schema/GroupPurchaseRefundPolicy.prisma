model GroupPurchaseRefundPolicy {
  id String @id @default(uuid())

  branchId String @unique
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  isEnabled Boolean @default(true)

  refundAllowed Boolean @default(true)
  policyFormat  String  @default("REFUND_TIERS_V1")
  boundaryMode  String  @default("MINIMUM_INCLUSIVE")

  // Refund rules based on minutes since purchase
  refundTiers Json

  // Package usage restrictions
  allowPartiallyUsedRefund Boolean @default(false)
  allowExpiredRefund       Boolean @default(false)

  // Whether existing appointments must be cancelled first
  requireNoActiveAppointments Boolean @default(true)

  version Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GroupPurchaseCancellationPolicy {
  id String @id @default(uuid())

  branchId String @unique
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  // =====================================================
  // POLICY SETTINGS
  // =====================================================

  isEnabled Boolean @default(true)

  cancellationAllowed Boolean @default(true)

  // Minimum minutes before appointment start
  // Cancellation is blocked below this threshold
  minimumCancellationMinutes Int @default(120)

  // Cancellation at or above this threshold
  // restores the package entitlement
  restorationMinimumMinutes Int @default(1440)

  // Cancellation allowed below restorationMinimumMinutes
  // but at or above minimumCancellationMinutes
  lateCancellationOutcome EntitlementCancellationOutcome @default(FORFEITED)

  // =====================================================
  // VERSIONING
  // =====================================================

  version Int @default(1)

  // =====================================================
  // TIMESTAMPS
  // =====================================================

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
