{
  "info": {
    "name": "Merchant Email Configuration - Manual Only",
    "description": "Unified merchant-only mail (v25): authentication and seven new business events use the single deployment merchant without platform fallback. Business delivery remains disabled. Owner inspection/configuration and explicit manual provider tests only. Never run as a batch: requests can send real emails, change configuration or skip jobs. Customer operations never call test-email. See unified-merchant-email-system.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{ownerToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://api-staging.example.com"
    },
    {
      "key": "brandId",
      "value": ""
    },
    {
      "key": "ownerToken",
      "value": ""
    },
    {
      "key": "gmailAppPassword",
      "value": ""
    },
    {
      "key": "qqEmail",
      "value": ""
    },
    {
      "key": "qqAuthorizationCode",
      "value": ""
    },
    {
      "key": "neteaseEmail",
      "value": ""
    },
    {
      "key": "neteaseAuthorizationCode",
      "value": ""
    },
    {
      "key": "microsoftEmail",
      "value": ""
    },
    {
      "key": "customFromEmail",
      "value": ""
    },
    {
      "key": "customSmtpHost",
      "value": ""
    },
    {
      "key": "customSmtpUsername",
      "value": ""
    },
    {
      "key": "customSmtpPassword",
      "value": ""
    },
    {
      "key": "resendFromEmail",
      "value": ""
    },
    {
      "key": "resendApiKey",
      "value": ""
    },
    {
      "key": "resendDomain",
      "value": ""
    },
    {
      "key": "outboxJobId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 View current configuration",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/brand-email-settings/{{brandId}}",
        "description": ""
      }
    },
    {
      "name": "02 Save Gmail",
