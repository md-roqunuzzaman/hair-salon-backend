          "mode": "raw",
          "raw": "{\n  \"fromName\": \"ABC Hair Salon\",\n  \"provider\": \"RESEND\",\n  \"fromEmail\": \"{{resendFromEmail}}\",\n  \"apiKey\": \"{{resendApiKey}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
