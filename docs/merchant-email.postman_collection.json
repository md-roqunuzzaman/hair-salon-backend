            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/brand-email-settings/{{brandId}}/microsoft/connect",
        "description": "Open authorizationUrl in the consenting account browser. The registered callback returns safe metadata. Never expose tokens.",
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
