          "raw": "{\n  \"fromName\": \"ABC Hair Salon\",\n  \"provider\": \"CUSTOM_SMTP\",\n  \"fromEmail\": \"{{customFromEmail}}\",\n  \"smtpHost\": \"{{customSmtpHost}}\",\n  \"smtpPort\": 465,\n  \"smtpSecure\": true,\n  \"smtpUsername\": \"{{customSmtpUsername}}\",\n  \"password\": \"{{customSmtpPassword}}\"\n}",
          "options": {
