        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fromName\": \"ABC Hair Salon\",\n  \"provider\": \"GMAIL\",\n  \"fromEmail\": \"khanrokon571@gmail.com\",\n  \"smtpUsername\": \"khanrokon571@gmail.com\",\n  \"password\": \"{{gmailAppPassword}}\"\n}",
          "options": {
