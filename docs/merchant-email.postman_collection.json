          }
        ],
        "url": "{{baseUrl}}/api/v1/brand-email-settings/{{brandId}}/resend/domain",
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"domain\": \"{{resendDomain}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "11 Check Resend DNS records/status",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/brand-email-settings/{{brandId}}/resend/domain",
        "description": ""
      }
    },
    {
      "name": "12 Request Resend domain verification",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/brand-email-settings/{{brandId}}/resend/domain/verify",
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "13 REAL SEND - CONFIRM FIRST - once per provider",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/brand-email-settings/{{brandId}}/test-email",
        "description": "STOP: ask user confirmation first. Send once per configured provider at most. No retries without approval. Provider acceptance is not inbox receipt. No booking, bulk or promotional messages.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"recipientEmail\": \"khanrokon571@gmail.com\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "14 Enable verified provider",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/brand-email-settings/{{brandId}}/enable",
        "description": ""
      }
    },
    {
      "name": "15 Disable provider (keeps credentials)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/brand-email-settings/{{brandId}}/disable",
        "description": ""
      }
    },
    {
      "name": "Inspect outbox (read only)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/brand-email-settings/{{brandId}}/outbox",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "brand-email-settings",
            "{{brandId}}",
            "outbox"
          ]
        },
        "description": "Owner-only paginated metadata, including AUTH_PASSWORD_RESET_OTP and AUTH_PASSWORD_RESET_SUCCESS filters. Does not process, retry, enable or send. Bodies and credentials are excluded. See unified-merchant-email-system.md."
      }
    },
    {
      "name": "17 Read-only paginated backlog audit",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/brand-email-settings/{{brandId}}/outbox/audit?status=PENDING&page=1&limit=100",
        "description": "Traverse all pages; eligibility applies to the current page only. ELIGIBLE/STALE/BLOCKED is current business-record validation, not provider readiness or inbox proof. No emails or database writes. Legacy snapshots stay blocked; old terminal records never replay."
      },
      "response": []
    },
    {
      "name": "18 Outbox safe job detail",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/brand-email-settings/{{brandId}}/outbox/{{outboxJobId}}",
        "description": "Safe metadata only. Non-pending eligibility never authorizes replay. Direct security jobs are not eligible for automatic business processing."
      },
      "response": []
    },
    {
      "name": "19 Outbox delivery history",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/brand-email-settings/{{brandId}}/outbox/{{outboxJobId}}/history?page=1&limit=100",
        "description": "Recorded transitions only; legacy attempts are not reconstructed. SENT means provider acceptance, not inbox delivery. No request retries or sends a message."
      },
      "response": []
    },
    {
      "name": "20 OWNER ACTION - permanently skip pending job",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/brand-email-settings/{{brandId}}/outbox/{{outboxJobId}}/skip",
        "description": "MANUAL OWNER ACTION: terminal suppression; never sends. Requires PENDING with matching attempt count and no active lease. Uncertain deliveries cannot be skipped or replayed by this endpoint. Do not run the entire collection.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"reason\": \"TEST_ONLY\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    }
  ]
}
