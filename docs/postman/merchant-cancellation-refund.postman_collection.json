{
  "info": {
    "name": "ABC Salon — Merchant Cancellation and Refund Acceptance",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "STAGING TEST DATA ONLY. Run selected steps manually; configure IDs and free slots first. Refunds require admin approval. This collection does not fake Stripe webhooks, call a production account, or automatically deploy. See CANCELLATION_REFUND_POLICY_API.md."
  },
  "item": [
    {
      "name": "1. Merchant policy configuration (changes future bookings)",
      "item": [
        {
          "name": "Read service-cancellation",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/policy-management/branches/{{branchId}}/service-cancellation"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code < 300) { const data = pm.response.json().data; pm.environment.set('serviceVersion', data.version); if (data.firstAppointment?.appointmentId) pm.environment.set('initialAppointmentId', data.firstAppointment.appointmentId); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Save service-cancellation",
