    {
      "name": "4. Ordinary cancellation and approval",
      "item": [
        {
          "name": "Preview service cancellation (read only)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/cancellation-refund/appointments/{{appointmentId}}/preview"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) { const data = pm.response.json().data; pm.environment.set('previewToken', data.previewToken); pm.test('Review eligibility before confirming', () => pm.expect(data.canCancel ?? data.canRequestRefund).to.eql(true)); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Confirm service cancellation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/cancellation-refund/appointments/{{appointmentId}}/cancel",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Customer requests cancellation\",\n  \"idempotencyKey\": \"{{cancellationKey}}\",\n  \"previewToken\": \"{{previewToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code < 300) { const data = pm.response.json().data; pm.environment.set('refundRequestId', data.refundRequestId); if (data.firstAppointment?.appointmentId) pm.environment.set('initialAppointmentId', data.firstAppointment.appointmentId); }"
                ]
              }
            }
          ]
        },
        {
          "name": "My refund requests",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/refund-requests/my"
          }
        },
        {
          "name": "Approve positive refund (owner)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/refund-requests/{{refundRequestId}}/review",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"APPROVE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Process approved refund (owner)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/refund-requests/{{refundRequestId}}/process",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
